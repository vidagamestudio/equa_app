# ============================================================
# Variables de entorno — Estudio Gestión
# Copiá este archivo como `.env.local` (o definilas en tu host)
# ============================================================

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://usuario:password@host:5432/base?sslmode=require"

# --- Seguridad ---
# Clave de cifrado de sesiones. Usá un valor largo y aleatorio (32+ caracteres).
SESSION_PASSWORD="cambiar-por-una-clave-larga-y-secreta"

# --- Marca / White-label (nombre, logo y colores del estudio) ---
# Todas las NEXT_PUBLIC_* son visibles en el navegador (no pongas secretos).
NEXT_PUBLIC_STUDIO_NAME="Estudio Aire"
NEXT_PUBLIC_STUDIO_SUBTITLE="Pilates · Gestión"
NEXT_PUBLIC_STUDIO_SHORT="Pilates"
NEXT_PUBLIC_STUDIO_CITY="Buenos Aires"
NEXT_PUBLIC_STUDIO_MARK="A"
NEXT_PUBLIC_STUDIO_ACCENT="#6d5bd0"
NEXT_PUBLIC_STUDIO_ACCENT_STRONG="#5a49b8"
NEXT_PUBLIC_STUDIO_ACCENT_SOFT="#efeefb"