generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String
}

model Profesora {
  id            String                  @id @default(cuid())
  nombre        String
  tarifaHora    Int
  activa        Boolean                 @default(true)
  clases        Clase[]
  liquidaciones LiquidacionProfesora[]
}

model Servicio {
  id       String  @id @default(cuid())
  nombre   String
  precio   Int
  cupo     Int
  duracion Int
  activo   Boolean @default(true)
  clases   Clase[]
}

model Alumna {
  id       String    @id @default(cuid())
  nombre   String
  email    String?
  telefono String?
  activa   Boolean   @default(true)
  abonos   Abono[]
  reservas Reserva[]
  ventas   Venta[]
}

model Abono {
  id            String   @id @default(cuid())
  alumnaId      String
  alumna        Alumna   @relation(fields: [alumnaId], references: [id])
  tipo          String
  precio        Int
  fechaInicio   DateTime
  fechaFin      DateTime?
  clasesTotales Int?
  clasesUsadas  Int      @default(0)
  estado        String
  ventas        Venta[]
}

model Clase {
  id          String    @id @default(cuid())
  fecha       DateTime
  horaInicio  String
  servicioId  String
  servicio    Servicio  @relation(fields: [servicioId], references: [id])
  profesoraId String
  profesora   Profesora @relation(fields: [profesoraId], references: [id])
  reservas    Reserva[]
}

model Reserva {
  id       String @id @default(cuid())
  claseId  String
  clase    Clase  @relation(fields: [claseId], references: [id])
  alumnaId String
  alumna   Alumna @relation(fields: [alumnaId], references: [id])
  estado   String @default("Confirmada")
}

model Venta {
  id              String  @id @default(cuid())
  fecha           DateTime
  alumnaId        String
  alumna          Alumna  @relation(fields: [alumnaId], references: [id])
  concepto        String
  tipoComprobante String
  monto           Int
  medioPago       String
  abonoId         String?
  abono           Abono?  @relation(fields: [abonoId], references: [id])
}

model Compra {
  id        String  @id @default(cuid())
  fecha     DateTime
  proveedor String
  concepto  String
  monto     Int
}

model Gasto {
  id        String   @id @default(cuid())
  fecha     DateTime
  categoria String
  concepto  String
  monto     Int
}

model LiquidacionProfesora {
  id          String    @id @default(cuid())
  mes         String
  profesoraId String
  profesora   Profesora @relation(fields: [profesoraId], references: [id])
  horas       Int
  monto       Int
  estado      String
}